#include <iostream>
using namespace std;

template <class T>
T sumArray(T arr[], int n) {
    T sum = 0;
    for(int i = 0; i < n; i++)
        sum += arr[i];
    return sum;
}

int main() {
    int a[] = {1, 2, 3};
    float b[] = {1.5, 2.5, 3.5};

    cout << sumArray(a, 3) << endl;
    cout << sumArray(b, 3);
}
